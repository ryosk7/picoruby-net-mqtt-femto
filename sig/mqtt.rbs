module Net
  module MQTT
    class Client
      def poll_sleep_ms: (Integer) -> void
      def wait_until_connected: (?timeout_ms: Integer, ?poll_interval_ms: Integer) -> bool
      def wait_until_disconnected: (?timeout_ms: Integer, ?poll_interval_ms: Integer) -> bool
      def wait_until_message_available: (?timeout_ms: Integer, ?poll_interval_ms: Integer) -> bool
      def with_reconnect: (?max_attempts: Integer?, ?base_delay_ms: Integer, ?max_delay_ms: Integer) { (Client) -> untyped } -> untyped
      def publish_with_reconnect: (String, untyped, ?retain: bool, ?qos: Integer, ?max_attempts: Integer?, ?base_delay_ms: Integer, ?max_delay_ms: Integer) -> untyped
      def subscribe_with_reconnect: (*String, ?qos: Integer, ?max_attempts: Integer?, ?base_delay_ms: Integer, ?max_delay_ms: Integer) -> untyped
      def unsubscribe_with_reconnect: (*String, ?max_attempts: Integer?, ?base_delay_ms: Integer, ?max_delay_ms: Integer) -> untyped
      def receive_with_reconnect: (?timeout: untyped, ?max_attempts: Integer?, ?base_delay_ms: Integer, ?max_delay_ms: Integer) -> [String, String]?
      def receive_with_reconnect: (?timeout: untyped, ?max_attempts: Integer?, ?base_delay_ms: Integer, ?max_delay_ms: Integer) { (String, String) -> untyped } -> untyped
      def connection_status: () -> Integer
      def connection_status_name: () -> String
      def connection_error?: () -> bool
      def native_state: () -> String
      def connecting?: () -> bool
      def active?: () -> bool
      def disconnecting?: () -> bool
      def timed_out?: () -> bool
      def publishing?: () -> bool
      def subscribing?: () -> bool
      def receive_queue_size: () -> Integer
      def message_available?: () -> bool
      def receive_queue_empty?: () -> bool
      def drain_messages: () -> Array[[String, String]]
      def each_message: () -> Enumerator[[String, String], Array[[String, String]]]
      def each_message: () { (String, String) -> untyped } -> Array[[String, String]]
      def drain_each_message: () { (String, String) -> untyped } -> Integer
      def pending_publish_topic: () -> String?
      def pending_publish?: () -> bool
      def pending_publish_qos: () -> Integer
      def pending_subscribe_topic: () -> String?
      def pending_subscribe?: () -> bool
      def pending_operation?: () -> bool
      def pending_topics: () -> Array[String]
      def subscriptions: () -> Hash[String, Integer]
      def each_subscription: () -> Enumerator[[String, Integer], Hash[String, Integer]]
      def each_subscription: () { (String, Integer) -> untyped } -> Hash[String, Integer]
      def subscribed?: (String) -> bool
      def subscription_qos: (String) -> Integer?
      def subscription_count: () -> Integer
      def stats: () -> Hash[Symbol, untyped]
      attr_accessor auto_resubscribe: bool

      private def _connect_impl: (String, Integer, String, Integer, String?, String?, String?, String?, Integer, bool) -> bool
      private def _connection_status_impl: () -> Integer
      private def _fsm_state_impl: () -> Integer
      private def _poll_impl: () -> void
      private def _poll_sleep_impl: (Integer) -> void
      private def _is_connected_impl: () -> bool
      private def _pending_publish_qos_impl: () -> Integer
      private def _pending_publish_topic_impl: () -> String?
      private def _pending_subscribe_topic_impl: () -> String?
      private def _receive_queue_size_impl: () -> Integer
      private def _publish_impl: (String, String, bool, Integer) -> bool
      private def _subscribe_impl: (String, Integer) -> bool
      private def _unsubscribe_impl: (String) -> bool
      private def _get_message_impl: () -> [String, String]?
      private def _disconnect_impl: () -> void
    end
  end
end
